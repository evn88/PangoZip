<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>PangoZip</string>
    <key>CFBundleDisplayName</key><string>PangoZip</string>
    <key>CFBundleIdentifier</key><string>app.pangozip.desktop</string>
    <key>CFBundleExecutable</key><string>PangoZip</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.5.0</string>
    <key>CFBundleVersion</key><string>9</string>
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>CFBundleDocumentTypes</key>
    <array><dict>
        <key>CFBundleTypeName</key><string>Archive</string>
        <key>CFBundleTypeRole</key><string>Viewer</string>
        <key>LSHandlerRank</key><string>Alternate</string>
        <key>CFBundleTypeExtensions</key>
        <array><string>zip</string><string>7z</string><string>rar</string><string>tar</string><string>gz</string><string>bz2</string><string>xz</string><string>tgz</string></array>
    </dict></array>
    <key>CFBundleURLTypes</key><array><dict>
        <key>CFBundleURLName</key><string>app.pangozip.finder</string>
        <key>CFBundleURLSchemes</key><array><string>pangozip</string></array>
    </dict></array>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMessage</key><string>openArchiveService</string>
            <key>NSMenuItem</key><dict><key>default</key><string>Открыть архив в PangoZip</string></dict>
            <key>NSSendTypes</key><array><string>public.file-url</string><string>NSFilenamesPboardType</string></array>
            <key>NSRequiredContext</key><dict><key>NSApplicationIdentifier</key><string>com.apple.finder</string></dict>
        </dict>
        <dict>
            <key>NSMessage</key><string>addToArchiveService</string>
            <key>NSMenuItem</key><dict><key>default</key><string>Добавить в архив PangoZip…</string></dict>
            <key>NSSendTypes</key><array><string>public.file-url</string><string>NSFilenamesPboardType</string></array>
            <key>NSRequiredContext</key><dict><key>NSApplicationIdentifier</key><string>com.apple.finder</string></dict>
        </dict>
    </array>
</dict>
</plist>
